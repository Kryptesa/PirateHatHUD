cmake_minimum_required(VERSION 3.28)
get_filename_component(REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TEST_ROOT)
  set(TEST_ROOT "${REPO_ROOT}/build/architecture-tests")
endif()

function(check_case name relative_path content expected)
  set(root "${TEST_ROOT}/${name}")
  file(MAKE_DIRECTORY "${root}")
  file(WRITE "${root}/${relative_path}" "${content}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DPROJECT_ROOT=${root}"
    -P "${REPO_ROOT}/cmake/Architecture.cmake" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL "PASS")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${name} unexpectedly failed: ${output}${error}")
    endif()
  elseif(result EQUAL 0 OR NOT "${error}" MATCHES "${expected}")
    message(FATAL_ERROR "${name} did not reject the intended violation: ${output}${error}")
  endif()
endfunction()

check_case(header_in_src src/render/bad.hpp "#pragma once\n" "headers belong in include")
