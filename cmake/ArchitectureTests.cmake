set(root "${TEST_ROOT}/target_dependency")
file(WRITE "${root}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28)\nproject(ArchitectureFixture NONE)\nset(PROJECT_ROOT \"${root}\")\ninclude(\"${REPO_ROOT}/cmake/Architecture.cmake\")\nadd_library(game_observers INTERFACE)\ntarget_link_libraries(game_observers INTERFACE imgui_static)\nphi_check_target(game_observers safetyhook)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${root}/build"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${error}" MATCHES "forbidden target dependency")
  message(FATAL_ERROR "Forbidden target dependency was not detected: ${output}${error}")
endif()

